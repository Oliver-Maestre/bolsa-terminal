PORT=3001

# Comma-separated list of allowed CORS origins (browser clients only —
# native apps are not subject to CORS). Defaults to localhost dev ports.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Shared bearer token required on all /api/* routes except /api/health.
# Leave unset for local dev (auth is skipped). Generate with: openssl rand -hex 32
API_TOKEN=

# Directory for JSON-file persistence of broker/bot state. Must be a
# mounted persistent volume in cloud deployments.
PERSIST_DIR=./data

# AI chat provider. Leave unset to auto-pick: Gemini if GEMINI_API_KEY is
# set (free tier, no card needed), else Anthropic if ANTHROPIC_API_KEY is
# set (paid). Set explicitly to "gemini" or "anthropic" to force one.
AI_PROVIDER=

# Google Gemini (https://aistudio.google.com/apikey) — free tier, recommended
# for a first iteration.
GEMINI_API_KEY=

# Anthropic Claude — paid, swap in later for higher-quality responses.
ANTHROPIC_API_KEY=

# Optional data providers
FMP_API_KEY=
ALPHA_VANTAGE_KEY=
